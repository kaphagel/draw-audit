<Window x:Class="DrawAudit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DrawAudit.App"
        Title="Draw Audit - Drawing Hierarchy Extraction"
        Width="900" Height="780" MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#FAFAFA" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="150" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="100" />
            </Grid.RowDefinitions>

            <!-- 1. Documents folder, inventory and template -->
            <TextBlock Grid.Row="0" Text="Documents folder:" VerticalAlignment="Center" Margin="0,0,8,6" FontWeight="SemiBold" />
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource PathBox}" Margin="0,0,6,6"
                     Text="{Binding SourceFolder}" ToolTip="{Binding SourceFolder}" />
            <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Margin="0,0,0,6"
                    Click="BrowseFolder_Click" IsEnabled="{Binding IsIdle}" />

            <TextBlock Grid.Row="1" Text="Inventory (optional):" VerticalAlignment="Center" Margin="0,0,8,6"
                       ToolTip="Optional. Files are found by scanning the documents folder; when an inventory workbook is given, differences are reported as warnings." />
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource PathBox}" Margin="0,0,6,6"
                     Text="{Binding InventoryPath}" ToolTip="{Binding InventoryPath}" />
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Browse..." Click="BrowseInventory_Click" IsEnabled="{Binding IsIdle}" />
                <Button Content="Clear" MinWidth="0" Margin="4,0,0,0" Click="ClearInventory_Click" IsEnabled="{Binding IsIdle}"
                        ToolTip="Do not cross-check against an inventory" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Summary template:" VerticalAlignment="Center" Margin="0,0,8,10" />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding TemplateInfo}"
                       VerticalAlignment="Center" Margin="2,0,0,10" Foreground="#555" />

            <!-- 2. Sub selection -->
            <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,0,0,4">
                <TextBlock Text="Subs:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="Select all" Click="SelectAll_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,6,0" />
                <Button Content="Deselect all" Click="DeselectAll_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" Foreground="#555" />
            </DockPanel>

            <Grid Grid.Row="4" Grid.ColumnSpan="3" Margin="0,0,0,10">
                <ListView x:Name="SubList" ItemsSource="{Binding Subs}" IsEnabled="{Binding IsIdle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SubItem}">
                            <Grid x:Name="Row">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding Processable}"
                                          Content="{Binding Sub}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Folder}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Folder}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Details}" Foreground="#666" VerticalAlignment="Center" />
                                <TextBlock x:Name="DlWarning" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="{Binding DlWarning}" ToolTip="{Binding DlWarning}"
                                           Foreground="#B35C00" TextWrapping="Wrap" Margin="0,1,0,2" Visibility="Collapsed" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasDlWarning}" Value="True">
                                    <Setter TargetName="DlWarning" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Processable}" Value="False">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                                    <Setter TargetName="Row" Property="ToolTip"
                                            Value="This Sub folder has no files under a DL or PDF folder, so there is nothing to process." />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="Scanning the documents folder..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#666" Visibility="{Binding IsLoadingSubs, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- 3. Output -->
            <TextBlock Grid.Row="5" Text="Output file:" VerticalAlignment="Center" Margin="0,0,8,10" FontWeight="SemiBold" />
            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource PathBox}" Margin="0,0,6,10"
                     Text="{Binding OutputPath}" ToolTip="{Binding OutputPath}" />
            <Button Grid.Row="5" Grid.Column="2" Content="Browse..." Margin="0,0,0,10"
                    Click="BrowseOutput_Click" IsEnabled="{Binding IsIdle}" />

            <!-- Run / progress -->
            <DockPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,0,0,8">
                <Button x:Name="RunButton" Content="Run" FontWeight="SemiBold" MinWidth="100"
                        Click="Run_Click" IsEnabled="{Binding CanRun}" Margin="0,0,6,0" />
                <Button Content="Cancel" Click="Cancel_Click" MinWidth="100" Margin="0,0,10,0"
                        IsEnabled="{Binding IsBusy}" />
                <ProgressBar Height="22" Minimum="0" Maximum="100" Value="{Binding Progress}" />
            </DockPanel>

            <!-- Result -->
            <Border Grid.Row="7" Grid.ColumnSpan="3" Margin="0,0,0,8" Padding="8,6" Background="#EEF6EE"
                    BorderBrush="#9CC79C" BorderThickness="1" CornerRadius="3"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button Content="Open folder" DockPanel.Dock="Right" Click="OpenFolder_Click" Margin="6,0,0,0" />
                    <Button Content="Open output" DockPanel.Dock="Right" Click="OpenOutput_Click" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ResultText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <!-- Log -->
            <TextBox x:Name="LogBox" Grid.Row="8" Grid.ColumnSpan="3" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12" Background="#FBFBFB"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </Grid>
    </DockPanel>
</Window>
